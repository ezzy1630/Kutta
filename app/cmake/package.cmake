# Script mode (cmake -P), driven by the package-app target in deploy.cmake.
cmake_minimum_required(VERSION 3.26)
string(REPLACE "|" ";" LICENSES "${LICENSES}")
file(REMOVE_RECURSE "${OUT}")
file(MAKE_DIRECTORY "${OUT}")

# The solver: one executable, or a folder with kutta[.exe] and its libraries.
set(real_cli FALSE)
if(SOLVER)
  if(IS_DIRECTORY "${SOLVER}")
    file(GLOB solver_files "${SOLVER}/*")
    if(EXISTS "${SOLVER}/kutta" OR EXISTS "${SOLVER}/kutta.exe")
      set(real_cli TRUE)
    endif()
  elseif(EXISTS "${SOLVER}")
    set(solver_files "${SOLVER}")
    set(real_cli TRUE)
  endif()
  if(NOT real_cli)
    message(FATAL_ERROR "No kutta CLI in ${SOLVER}")
  endif()
endif()

function(copy_solver dest)
  file(MAKE_DIRECTORY "${dest}")
  if(real_cli)
    foreach(f ${solver_files})
      get_filename_component(name "${f}" NAME)
      if(name MATCHES "^kutta-cli(\\.exe)?$")  # the in-tree target's file name
        string(REPLACE "kutta-cli" "kutta" name "${name}")
      endif()
      file(COPY_FILE "${f}" "${dest}/${name}")
    endforeach()
  else()
    message(STATUS "No solver given: bundling the fixture CLI (recorded and synthetic data)")
    get_filename_component(name "${FIXTURE}" NAME)
    file(COPY_FILE "${FIXTURE}" "${dest}/${name}")
  endif()
endfunction()

if(APPLE)
  get_filename_component(macos "${APP}" DIRECTORY)
  get_filename_component(contents "${macos}" DIRECTORY)
  get_filename_component(bundle "${contents}" DIRECTORY)
  set(app "${OUT}/Kutta.app")
  file(COPY "${bundle}/" DESTINATION "${app}")
  copy_solver("${app}/Contents/Helpers")
  if(NOT real_cli)
    file(COPY "${FIXTURE_DATA}/" DESTINATION "${app}/Contents/Resources/fixtures")
  endif()
  file(MAKE_DIRECTORY "${app}/Contents/Resources/licenses")
  foreach(l ${LICENSES})
    file(COPY "${l}" DESTINATION "${app}/Contents/Resources/licenses")
  endforeach()
  file(COPY "${ADS}" DESTINATION "${app}/Contents/Frameworks" FOLLOW_SYMLINK_CHAIN)
  # macdeployqt also copies the CLI's own libraries (HDF5 from Homebrew).
  if(real_cli)
    set(extra "-executable=${app}/Contents/Helpers/kutta")
  else()
    get_filename_component(name "${FIXTURE}" NAME)
    set(extra "-executable=${app}/Contents/Helpers/${name}")
  endif()
  execute_process(COMMAND "${DEPLOYQT}" "${app}" -always-overwrite ${extra} COMMAND_ERROR_IS_FATAL ANY)
  # Rewritten load commands invalidate signatures; Apple silicon needs one (ad hoc).
  execute_process(COMMAND codesign --force --deep --sign - "${app}" COMMAND_ERROR_IS_FATAL ANY)
  execute_process(COMMAND ditto -c -k --keepParent "${app}" "${OUT}/Kutta-${VERSION}-macos.zip"
                  COMMAND_ERROR_IS_FATAL ANY)
elseif(WIN32)
  set(root "${OUT}/Kutta")
  file(COPY_FILE "${APP}" "${root}/Kutta.exe")
  file(COPY "${ADS}" DESTINATION "${root}")
  copy_solver("${root}/solver")
  if(NOT real_cli)
    file(COPY "${FIXTURE_DATA}/" DESTINATION "${root}/solver/fixtures")
  endif()
  file(MAKE_DIRECTORY "${root}/licenses")
  foreach(l ${LICENSES})
    file(COPY "${l}" DESTINATION "${root}/licenses")
  endforeach()
  execute_process(COMMAND "${DEPLOYQT}" --release --no-translations --no-system-d3d-compiler "${root}/Kutta.exe"
                  COMMAND_ERROR_IS_FATAL ANY)
  if(NOT real_cli)
    # The fixture links QtCore and QtGui; Windows looks for DLLs beside the executable.
    file(GLOB qtcore "${root}/Qt6Core.dll" "${root}/Qt6Gui.dll")
    file(COPY ${qtcore} DESTINATION "${root}/solver")
  endif()
  execute_process(COMMAND "${CMAKE_COMMAND}" -E tar cf "${OUT}/Kutta-${VERSION}-windows.zip" --format=zip Kutta
                  WORKING_DIRECTORY "${OUT}" COMMAND_ERROR_IS_FATAL ANY)
else()
  message(FATAL_ERROR "Packaging supports macOS and Windows")
endif()
message(STATUS "Packaged into ${OUT}")
