+// SCRATCH: per-side quadratic Taylor shifts with gradient-of-gradient Hessians.
+KUTTA_KERNEL void fv_hessian_transport_faces(int i, KIn(int) owner, KIn(int) neighbour,
+    KIn(float) px, KIn(float) py, KIn(float) pz,
+    KIn(float) nx, KIn(float) ny, KIn(float) nz,
+    KIn(float) sx, KIn(float) sy, KIn(float) sz, KIn(float) alpha,
+    KIn(float) gx, KIn(float) gy, KIn(float) gz,
+    KIn(float) hxx, KIn(float) hxy, KIn(float) hxz, KIn(float) hyx, KIn(float) hyy, KIn(float) hyz,
+    KIn(float) hzx, KIn(float) hzy, KIn(float) hzz, KIn(float) limiter,
+    KIn(float) flux, KIn(float) mu, KIn(int) kind, KOut(float) correction,
+    int internal, int second_order) {
+  int p=owner[i];
+  float a2=sx[i]*sx[i]+sy[i]*sy[i]+sz[i]*sz[i];
+  float dpn=(px[i]*sx[i]+py[i]*sy[i]+pz[i]*sz[i])/a2;
+  float tx=px[i]-dpn*sx[i],ty=py[i]-dpn*sy[i],tz=pz[i]-dpn*sz[i];
+  float quad=tx*(hxx[p]*tx+hxy[p]*ty+hxz[p]*tz)+ty*(hyx[p]*tx+hyy[p]*ty+hyz[p]*tz)+tz*(hzx[p]*tx+hzy[p]*ty+hzz[p]*tz);
+  float diffusion=-alpha[i]*(gx[p]*tx+gy[p]*ty+gz[p]*tz+0.5f*quad);
+  float conv=0.0f;
+  if(i<internal) {
+    int n=neighbour[i];
+    float dnn=(nx[i]*sx[i]+ny[i]*sy[i]+nz[i]*sz[i])/a2;
+    float ux=nx[i]-dnn*sx[i],uy=ny[i]-dnn*sy[i],uz=nz[i]-dnn*sz[i];
+    float qn=ux*(hxx[n]*ux+hxy[n]*uy+hxz[n]*uz)+uy*(hyx[n]*ux+hyy[n]*uy+hyz[n]*uz)+uz*(hzx[n]*ux+hzy[n]*uy+hzz[n]*uz);
+    diffusion+=alpha[i]*(gx[n]*ux+gy[n]*uy+gz[n]*uz+0.5f*qn);
+    int up=flux[i]>=0.0f?p:n;
+    float rx=flux[i]>=0.0f?px[i]:nx[i],ry=flux[i]>=0.0f?py[i]:ny[i],rz=flux[i]>=0.0f?pz[i]:nz[i];
+    conv=limiter[up]*(gx[up]*rx+gy[up]*ry+gz[up]*rz)*flux[i];
+  } else {
+    if(kind[i-internal]!=0) diffusion=0.0f;
+    if(flux[i]>0.0f && kind[i-internal]!=2) conv=limiter[p]*(gx[p]*px[i]+gy[p]*py[i]+gz[p]*pz[i])*flux[i];
+  }
+  correction[i]=mu[i]*diffusion-(second_order!=0?conv:0.0f);
+}
