diff --git a/src/kutta/kernels/fv_flow.kern.h b/src/kutta/kernels/fv_flow.kern.h
index b279057..6ac9e04 100644
--- a/src/kutta/kernels/fv_flow.kern.h
+++ b/src/kutta/kernels/fv_flow.kern.h
@@ -239,3 +239,47 @@ KUTTA_KERNEL void fv_fluent_momentum_scale(int i,KIn(float) ax,KIn(float) ay,KIn
   float time=dt>0.0f?rho*volume[i]/dt:0.0f;
   x[i]=2.0f*(ax[i]+time)*speed[i];y[i]=2.0f*(ay[i]+time)*speed[i];z[i]=2.0f*(az[i]+time)*speed[i];
 }
+
+// EXPERIMENT: face += alpha*(side - face), side = a_P-weighted mean of the
+// two limited side reconstructions.
+KUTTA_KERNEL void fv_exp_side_blend(int i,KIn(int) owner,KIn(int) neighbour,
+    KIn(float) px,KIn(float) py,KIn(float) pz,KIn(float) nx,KIn(float) ny,KIn(float) nz,
+    KIn(float) u,KIn(float) v,KIn(float) w,
+    KIn(float) ux,KIn(float) uy,KIn(float) uz,KIn(float) vx,KIn(float) vy,KIn(float) vz,
+    KIn(float) wx,KIn(float) wy,KIn(float) wz,KIn(float) diagonal,KIn(float) alpha,
+    KOut(float) fu,KOut(float) fv,KOut(float) fw) {
+  float a=alpha[i];if(a==0.0f) return;
+  int p=owner[i],n=neighbour[i];float weight=diagonal[p]/(diagonal[p]+diagonal[n]);
+  float su=weight*(u[p]+ux[p]*px[i]+uy[p]*py[i]+uz[p]*pz[i])+(1.0f-weight)*(u[n]+ux[n]*nx[i]+uy[n]*ny[i]+uz[n]*nz[i]);
+  float sv=weight*(v[p]+vx[p]*px[i]+vy[p]*py[i]+vz[p]*pz[i])+(1.0f-weight)*(v[n]+vx[n]*nx[i]+vy[n]*ny[i]+vz[n]*nz[i]);
+  float sw=weight*(w[p]+wx[p]*px[i]+wy[p]*py[i]+wz[p]*pz[i])+(1.0f-weight)*(w[n]+wx[n]*nx[i]+wy[n]*ny[i]+wz[n]*nz[i]);
+  fu[i]+=a*(su-fu[i]);fv[i]+=a*(sv-fv[i]);fw[i]+=a*(sw-fw[i]);
+}
+
+// EXPERIMENT: replace the wall-normal component of a wall cell's gradient by
+// the quadratic through the wall value, the cell and its opposite neighbour.
+KUTTA_KERNEL void fv_exp_wall_gradient(int i,KIn(int) nb,KIn(int) bf,KIn(float) nx,KIn(float) ny,KIn(float) nz,
+    KIn(float) delta,KIn(float) span,KIn(float) cell,KIn(float) boundary,
+    KOut(float) gx,KOut(float) gy,KOut(float) gz) {
+  int m=nb[i];if(m<0) return;
+  float d=delta[i],D=span[i],uc=cell[i];
+  float gs=((cell[m]-uc)*d*d-(boundary[bf[i]]-uc)*D*D)/(d*D*(d+D));
+  float cur=-(gx[i]*nx[i]+gy[i]*ny[i]+gz[i]*nz[i]);
+  float c=gs-cur;
+  gx[i]-=c*nx[i];gy[i]-=c*ny[i];gz[i]-=c*nz[i];
+}
+
+// EXPERIMENT: per-cell convective outflow sum(max(F_out,0)).
+KUTTA_KERNEL void fv_exp_outflow(int i,KIn(int) offsets,KIn(int) faces,KIn(float) sign,KIn(float) flux,KOut(float) out) {
+  float s=0.0f;
+  for(int j=offsets[i];j<offsets[i+1];++j) s+=kmax(0.0f,sign[j]*flux[faces[j]]);
+  out[i]=s;
+}
+// EXPERIMENT: mode 1 = (outP+outN)/(aP+aN); 2 = (outP/aP)(outN/aN); times the static mask.
+KUTTA_KERNEL void fv_exp_peclet_alpha(int i,KIn(int) owner,KIn(int) neighbour,KIn(float) out,KIn(float) diagonal,
+    KIn(float) mask,KOut(float) alpha,int mode) {
+  int p=owner[i],n=neighbour[i];
+  float ap=kmax(diagonal[p],1.0e-30f),an=kmax(diagonal[n],1.0e-30f);
+  float a=mode==1?(out[p]+out[n])/(ap+an):(out[p]/ap)*(out[n]/an);
+  alpha[i]=mask[i]*kmax(0.0f,kmin(1.0f,a));
+}
